<StackMasterConfig>
    <!-- Configuration for perks that affect stack sizes -->
    <Perks>
        <!-- 
        Multiple perks can be added
        name = perk name in progression.xml
        itemFilter = which items are affected (if empty - all items)
		Exclude = which items will be added to the blacklist in the perk config
        -->
        
        <!-- Main perk for all items -->
        <Perk name="perkStackMaster" itemFilter="">
            <Level level="1" multiplier="1.25"/>
            <Level level="2" multiplier="1.5"/>
            <Level level="3" multiplier="1.75"/>
            <Level level="4" multiplier="2.0"/>
            <Level level="5" multiplier="2.5"/>
        </Perk>
		
        <!-- Example: perk only for pistol ammo
        <Perk name="perkHandgunAmmoPouch" itemFilter="ammo9mm,ammo44Magnum">
            <Level level="1" multiplier="1.5"/>
            <Level level="2" multiplier="2.0"/>
            <Level level="3" multiplier="2.5"/>
			<Level level="4" multiplier="3.0"/>
        </Perk> -->
		
        <!-- Example: Pack Mule for resources
        <Perk name="perkPackMule" itemFilter="resource">
            <Level level="1" multiplier="1.2"/>
            <Level level="2" multiplier="1.4"/>
            <Level level="3" multiplier="1.6"/>
        </Perk> -->
		
		<!-- Example: Master Chef - increases food stacks but excludes crops, etc
        <Perk name="perkMasterChef" itemFilter="food">
            <Exclude>
                <Item name="foodCropPotato"/>
                <Item name="foodCropCorn"/>
                <Item name="foodCropBlueberries"/>
            </Exclude>
            <Level level="1" multiplier="1.5"/>
            <Level level="2" multiplier="2.0"/>
        </Perk> -->

        <!-- Example: Farmer - increases only crop stacks
        <Perk name="perkFarmer" itemFilter="foodCropBlueberries,foodCropCorn,foodCropGraceCorn,foodCropPotato,foodCropMushrooms,foodCropMushroomsRadiated">
            <Level level="1" multiplier="1.5"/>
        </Perk> -->

        <!-- Example: Pack Mule for resources, excluding rare items
        <Perk name="perkPackMule" itemFilter="resource">
            <Exclude>
                <Item name="resourceRawDiamond"/>
                <Item name="resourceGoldNugget"/>
				<Item name="resourceSilverNugget"/>
            </Exclude>
            <Level level="1" multiplier="1.2"/>
            <Level level="2" multiplier="1.4"/>
            <Level level="3" multiplier="1.6"/>
        </Perk> -->
		
    </Perks>
    <!-- Global exclusions (apply to all perks) -->
    <GlobalExclusions>
        <!-- <Item name="resourceWood"/> -->
    </GlobalExclusions>
</StackMasterConfig>