<configs>
	<set xpath="/windows/window[@name='windowToolbelt']">
		<rect>
			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" on_press="true"  gamepad_selectable="false"/>
			
			<rect pos="-73,-3" controller="Toolbelt">
				<grid depth="10" name="inventory" rows="1" cols="20" pos="0,0" cell_width="75" cell_height="75" repeat_content="true">
					<item_stack name="0"/>
				</grid>
				<button depth="3" name="btnClearInventory1" sprite="ui_game_symbol_trash" tooltip_key="lblClearInventory" pos="800, -32" style="icon32px, press, hover" pivot="center" sound="[paging_click]" visible="{creativewindowopen}" />
				<grid depth="10" name="inventory2" rows="1" cols="30" pos="0,82" cell_width="75" cell_height="75" repeat_content="true" visible="{secondrow}">
					<item_stack name="0"/>
				</grid>
				<button depth="3" name="btnClearInventory2" sprite="ui_game_symbol_trash" tooltip_key="lblClearInventory" pos="800, 50" style="icon32px, press, hover" pivot="center" sound="[paging_click]" visible="{# creativewindowopen and secondrow}" />
			</rect>

			<grid depth="20" name="numberLabels" rows="1" cols="20" pos="-70,-5" cell_width="75" cell_height="20" repeat_content="false">
				<label name="label1" text="1" alignment="left" font_size="19" color="[white]" />
				<label name="label2" text="2" alignment="left" font_size="19" color="[white]" />
				<label name="label3" text="3" alignment="left" font_size="19" color="[white]" />
				<label name="label4" text="4" alignment="left" font_size="19" color="[white]" />
				<label name="label5" text="5" alignment="left" font_size="19" color="[white]" />
				<label name="label6" text="6" alignment="left" font_size="19" color="[white]" />
				<label name="label7" text="7" alignment="left" font_size="19" color="[white]" />
				<label name="label8" text="8" alignment="left" font_size="19" color="[white]" />
				<label name="label9" text="9" alignment="left" font_size="19" color="[white]" />
				<label name="label10" text="10" alignment="left" font_size="19" color="[white]" />
				<label name="label11" text="11" alignment="left" font_size="19" color="[white]" />
				<label name="label12" text="12" alignment="left" font_size="19" color="[white]" />
				<label name="label13" text="13" alignment="left" font_size="19" color="[white]" />
				<label name="label14" text="14" alignment="left" font_size="19" color="[white]" />
				<label name="label15" text="15" alignment="left" font_size="19" color="[white]" />
				<label name="label16" text="16" alignment="left" font_size="19" color="[white]" />
				<label name="label17" text="17" alignment="left" font_size="19" color="[white]" />
				<label name="label18" text="18" alignment="left" font_size="19" color="[white]" />
				<label name="label19" text="19" alignment="left" font_size="19" color="[white]" />
				<label name="label20" text="20" alignment="left" font_size="19" color="[white]" />
			</grid>

			<sprite depth="1" pos="-75,6" height="8" width="1502" color="[mediumGrey]" sprite="menu_empty2px" globalopacity="false" type="sliced" />
			<sprite depth="9" pos="-75,6" height="8" width="1502" color="[black]" sprite="menu_empty2px" globalopacity="false" type="sliced" fillcenter="false" />
			<sprite depth="4" pos="-75,6" height="8" width="1502" color="{xpcolor}" globalopacity="false" type="filled" fill="{xp}" />

			<rect pos="-75,-77" width="753" height="8" controller="HUDStatBar" stat_type="Food" visible="{statvisible}">
				<sprite depth="1" color="[mediumGrey]" sprite="menu_empty2px" globalopacity="false" type="sliced" />
				<sprite depth="9" color="[black]" sprite="menu_empty2px" globalopacity="false" type="sliced" fillcenter="false" />

				<filledsprite depth="5" pos="1,0" width="751" name="BarContent" color="0,255,54,128" globalopacity="false" type="filled" fill="0"  />
			</rect>

			<rect pos="677,-77" width="751" height="8" controller="HUDStatBar" stat_type="Water" visible="{statvisible}">
				<sprite depth="1" color="[mediumGrey]" sprite="menu_empty2px" globalopacity="false" type="sliced" />
				<sprite depth="9" color="[black]" sprite="menu_empty2px" globalopacity="false" type="sliced" fillcenter="false" />

				<filledsprite depth="5" pos="1,0" width="751" name="BarContent" color="0,54,255,160" globalopacity="false" type="filled" fill="0"  />
			</rect>
		</rect>
	</set>
	
	<set xpath="/windows/window[@name='windowToolbelt']/@pos">-660, 92</set>
</configs>