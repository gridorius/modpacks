<configs>
  <append xpath="/Sounds">
    <!-- One-shot version of the turret overheat warning. Do not loop this; the old loop could stick to the player. -->
    <SoundDataNode name="minigun_overheat">
      <AudioSource name="@:Sounds/Prefabs/AudioSource_Interact.prefab" />
      <Noise ID="2" noise="11" time="3" muffled_when_crouched="0.5" />
      <AudioClip ClipName="@:Sounds/Electricity/Turret/turret_overheat_lp.wav" />
      <LocalCrouchVolumeScale value="0.5" />
      <CrouchNoiseScale value="1" />
      <NoiseScale value="1" />
      <MaxVoices value="10" />
      <MaxRepeatRate value="0.001" />
    </SoundDataNode>

    <SoundDataNode name="minigun_fire">
      <AudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire.prefab" />
      <NetworkAudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire_Network.prefab" />
      <Noise ID="0" noise="54" time="2" muffled_when_crouched="0.8" heat_map_strength="0.3" heat_map_time="180" />
      <AudioClip ClipName="@:Sounds/Weapons/Ranged/M60/m60_fire1.wav" />
      <AudioClip ClipName="@:Sounds/Weapons/Ranged/M60/m60_fire2.wav" />
      <AudioClip ClipName="@:Sounds/Weapons/Ranged/M60/m60_fire3.wav" />
      <AudioClip ClipName="@:Sounds/Weapons/Ranged/M60/m60_fire4.wav" />
      <AudioClip ClipName="@:Sounds/Twitch/Silly/m60_fire_silly1.wav" AltSound="true" />
      <AudioClip ClipName="@:Sounds/Twitch/Silly/m60_fire_silly2.wav" AltSound="true" />
      <AudioClip ClipName="@:Sounds/Twitch/Silly/m60_fire_silly3.wav" AltSound="true" />
      <LocalCrouchVolumeScale value="1" />
      <CrouchNoiseScale value="1" />
      <NoiseScale value="1" />
      <MaxVoices value="80" />
      <MaxVoicesPerEntity value="40" />
      <MaxRepeatRate value="0.001" />
    </SoundDataNode>
  </append>
</configs>
