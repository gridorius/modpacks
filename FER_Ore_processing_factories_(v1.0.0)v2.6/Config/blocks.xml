<Config>
	<append xpath="/blocks">
	
		<!-- Ore processing Machines -->
		<!-- Mining Rig  -->
		<block name="MiningRig_FER"> <!-- Mining Rig  -->
			<property name="CustomIcon" value="MiningRig_FER"/>  <!-- Mining Rig  -->
			<property name="DescriptionKey" value="MiningRig_FERDesc"/> <!-- Mining Rig  -->
			<property name="UnlockedBy" value="craftingWorkstations"/>
			<property name="Class" value="Workstation"/>
			<property name="Material" value="Mmetal"/> 
			<property name="MaxDamage" value="1200"/> <!-- Mining Rig  -->
			<property name="StabilitySupport" value="false"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/processing_factories_FER.unity3d?MiningRig_FER.prefab"/> <!-- Mining Rig  -->
			<property name="DisplayType" value="blockMulti"/>
			<property name="MultiBlockDim" value="2,4,1"/>  <!-- Mining Rig  -->
			<property name="ModelOffset" value="0,0,0"/> 
			<property name="ImposterDontBlock" value="true"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="HeatMapStrength" value="3"/> <!-- Mining Rig  -->
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="Stacknumber" value="1"/>
			<property class="Workstation">
			<property name="Modules" value="tools,output"/> <!-- Mining Rig  -->
			<property name="CraftingAreaRecipes" value="MiningRig_FER"/> <!-- this will be on your recipes! -->
			</property>
			<property name="WorkstationIcon" value="ui_game_symbol_mining"/> <!-- This is the UI icon, not the actual workstation Icon for the toolbelt/backpack/crate -->
			<property name="OpenSound" value="cement_mixer_open"/> <!-- Mining Rig  -->
			<property name="CloseSound" value="cement_mixer_close"/> <!-- Mining Rig  -->
			<property name="CraftSound" value="cement_mixer_start_click"/> <!-- Mining Rig  -->
			<property name="CraftCompleteSound" value="cement_mixer_complete"/> <!-- Mining Rig  -->
			<property name="WorkstationJournalTip" value="workbenchTip"/>
			<property class="RepairItems">	 <!-- Edit as needed below for the repair items -->
			<property name="resourceForgedIron" value="10"/> <!-- Mining Rig  -->
			<property name="resourceMechanicalParts" value="3"/> <!-- Mining Rig  -->
			<property name="resourceElectricParts" value="3"/> <!-- Mining Rig  -->
			</property>
			<drop event="Harvest" name="resourceForgedIron" count="10" tag="allHarvest"/> <!-- Mining Rig  -->
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="TakeDelay" value="10"/> 
			<property name="EconomicValue" value="500"/>
			<property name="Group" value="Basics,Building"/>
			<property name="SellableToTrader" value="false"/>
			<property name="FilterTags" value="fdecor,fother,ffurniture"/>
			<property name="SortOrder1" value="70i0"/>
		</block>
		
		<!-- Extraction Furnace  -->
		<block name="ExtractionFurnace_FER">
			<property name="CustomIcon" value="ExtractionFurnace_FER"/> 
			<property name="DescriptionKey" value="ExtractionFurnace_FERDesc"/>
			<property name="UnlockedBy" value="craftingWorkstations"/>
			<property name="Class" value="Campfire"/>
			<property name="Material" value="Mmetal"/> 
			<property name="MaxDamage" value="500"/> 
			<property name="StabilitySupport" value="false"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/processing_factories_FER.unity3d?ExtractionFurnace_FER.prefab"/> 
			<property name="DisplayType" value="blockMulti"/>
			<property name="MultiBlockDim" value="1,2,1"/> 
			<property name="ModelOffset" value="0,0,0"/> 
			<property name="ImposterDontBlock" value="true"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="HeatMapStrength" value="9"/>
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="Stacknumber" value="1"/>
			<property class="Workstation">
			<property name="Modules" value="tools,output,fuel,input"/>
			<property name="CraftingAreaRecipes" value="ExtractionFurnace_FER"/> 
			</property>
			<property name="WorkstationIcon" value="ui_game_symbol_mining"/> 
			<property name="OpenSound" value="campfire_open"/> 
			<property name="CloseSound" value="campfire_close"/>
			<property name="CraftSound" value="forge_smelt_click"/>
			<property name="CraftCompleteSound" value="forge_item_complete"/>
			<property name="WorkstationJournalTip" value="workbenchTip"/>
			<property class="RepairItems">	 
			<property name="resourceForgedIron" value="5"/>
			<property name="resourceMetalPipe" value="3"/>
			</property>
			<drop event="Harvest" name="resourceForgedIron" count="5" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="TakeDelay" value="10"/> 
			<property name="EconomicValue" value="200"/>
			<property name="Group" value="Basics,Building"/>
			<property name="SellableToTrader" value="false"/>
			<property name="FilterTags" value="fdecor,fother,ffurniture"/>
			<property name="SortOrder1" value="70i0"/>
		</block>
		
		<!-- Ore Crusher  -->
		<block name="OreCrusher_FER">
			<property name="CustomIcon" value="OreCrusher_FER"/> 
