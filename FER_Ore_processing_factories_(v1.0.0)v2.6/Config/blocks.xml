			<property name="DisplayType" value="blockMulti"/>
			<property name="MultiBlockDim" value="2,2,1"/> 
			<property name="ModelOffset" value="0,0,0"/> 
			<property name="ImposterDontBlock" value="true"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="HeatMapStrength" value="5"/>
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="Stacknumber" value="1"/>
			<property class="Workstation">
			<property name="Modules" value="tools,output"/>
			<property name="CraftingAreaRecipes" value="OreCrusher_FER"/> 
			</property>
			<property name="WorkstationIcon" value="ui_game_symbol_mining"/> 
			<property name="OpenSound" value="cement_mixer_open"/> 
			<property name="CloseSound" value="cement_mixer_close"/>
			<property name="CraftSound" value="cement_mixer_start_click"/>
			<property name="CraftCompleteSound" value="cement_mixer_complete"/>
			<property name="WorkstationJournalTip" value="workbenchTip"/>
			<property class="RepairItems">	 <!-- Edit as needed below for the repair items -->
			<property name="resourceForgedIron" value="10"/> <!-- Mining Rig  -->
			<property name="resourceMechanicalParts" value="3"/> <!-- Mining Rig  -->
			<property name="resourceElectricParts" value="3"/> <!-- Mining Rig  -->
			</property>
			<drop event="Harvest" name="resourceForgedIron" count="10" tag="allHarvest"/> <!-- Mining Rig  -->
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="TakeDelay" value="10"/> 
			<property name="EconomicValue" value="500"/>
			<property name="Group" value="Basics,Building"/>
			<property name="SellableToTrader" value="false"/>
			<property name="FilterTags" value="fdecor,fother,ffurniture"/>
			<property name="SortOrder1" value="70i0"/>
		</block>
		
		
	</append>
</Config>
