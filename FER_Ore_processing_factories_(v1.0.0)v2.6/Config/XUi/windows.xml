<Config>
	<append xpath="/windows">
	
		<!-- Mining Rig  -->
		<window name="windowToolsMiningRig_FER" width="228" height="121" panel="Right" cursor_area="true" >
			<panel style="header.panel">
				<sprite style="header.icon" sprite="ui_game_symbol_wrench"/>
				<label style="header.name" text="TOOLS" text_key="xuiTools" />
			</panel>

			<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
			
				<grid name="inventory" rows="1" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true"
				required_tools="meleeToolPickT1IronPickaxe,meleeToolPickT2SteelPickaxe,meleeToolPickT3Auger" required_tools_only="true">
					<item_stack controller="RequiredItemStack" name="0"/>
				</grid>	
			</rect>
		</window>
		
		<!-- Ekstrakt Furnace -->
		<window name="windowToolsExtractionFurnace_FER" width="228" height="121" panel="Right" cursor_area="true" >
			<panel style="header.panel">
				<sprite style="header.icon" sprite="ui_game_symbol_wrench"/>
				<label style="header.name" text="TOOLS" text_key="xuiTools" />
			</panel>

			<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
			
				<grid name="inventory" rows="1" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true"
				required_tools="toolBellows,tooldoubleBellowsFER,toolForgeCrucible" required_tools_only="true">
					<item_stack controller="RequiredItemStack" name="0"/>
				</grid>	
			</rect>
		</window>
		
		<!-- Ore Crusher -->
		<window name="windowToolsOreCrusher_FER" width="228" height="121" panel="Right" cursor_area="true" >
			<panel style="header.panel">
				<sprite style="header.icon" sprite="ui_game_symbol_wrench"/>
				<label style="header.name" text="TOOLS" text_key="xuiTools" />
			</panel>

			<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
			
				<grid name="inventory" rows="1" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true"
				required_tools="meleeWpnSledgeT1IronSledgehammer,ToolIronCrushRollerFER,tooldiamondCrushRollerFER" required_tools_only="true">
					<item_stack controller="RequiredItemStack" name="0"/>
				</grid>	
			</rect>
		</window>

		
	</append>
</Config>

