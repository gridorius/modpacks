<!-- STALKER -->
<append xpath="/buffs">
	<buff name="buffStalkerVanish" name_key="buffStalkerVanish" description_key="buffStalkerVanishDesc" icon="mp_stalker">
		<duration value="15"/>
		<stack_type value="duration"/> 
		<display_value value="duration"/>
		<display_value_format value="time"/>

		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="wear_armorclothes_place"/>
			<triggered_effect trigger="onSelfBuffRemove" action="PlaySound" sound="wear_armorclothes_place"/>
		</effect_group>
		
		<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Greyscale" intensity=".5" fade=".2"/>
			<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Greyscale" intensity="0" fade=".2"/>
			
			<passive_effect name="LightMultiplier" operation="perc_add" value="-2"/>
			<passive_effect name="NoiseMultiplier" operation="perc_add" value="-2"/>
			<passive_effect name="EnemySearchDuration" operation="perc_add" value="20"/>
		</effect_group>
	</buff>

	<buff name="buffStalkerVanishCooldownT1" name_key="buffStalkerVanishCooldownT1" description_key="buffStalkerVanishCooldownDescT1" icon="ui_game_symbol_clock" showonhud="false">
		<duration value="480"/>
		<stack_type value="replace"/>
		<display_value value="duration"/>
		<display_value_format value="time"/>
		
		<effect_group>
			<triggered_effect trigger="onSelfBuffRemove" action="PlaySound" sound="twitch_cooldown_ended"/>
		</effect_group>
	</buff>
	
