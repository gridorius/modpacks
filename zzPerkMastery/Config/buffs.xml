		<effect_group>
			<triggered_effect trigger="onSelfBuffRemove" action="PlaySound" sound="twitch_cooldown_ended"/>
		</effect_group>
	</buff>
	
	<buff name="buffStalkerVanishCooldownT3" name_key="buffStalkerVanishCooldownT3" description_key="buffStalkerVanishCooldownDescT3" icon="ui_game_symbol_clock" showonhud="false">
