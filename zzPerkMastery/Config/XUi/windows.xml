<windows>
	<conditional>
		<if cond="!mod_loaded('zSMXui')">
			<!-- Expands the number of allowed attributes -->
			<setattribute xpath="/windows/window[@name='windowSkillList']/panel[@name='content']/rect[@name='categoryHeader']/panel/grid" name="cols">15</setattribute>
			<!-- Modifies the position and size of the search box -->
			<setattribute xpath="/windows/window[@name='windowSkillList']//panel[@pos='394,0']" name="pos">409,0</setattribute>
			<setattribute xpath="/windows/window[@name='windowSkillList']//textfield[@name='searchInput']" name="width">110</setattribute>
		</if>
	</conditional>	

	<conditional>
		<if cond="mod_loaded('zSMXui')">
			<append xpath="/windows/window[@name='windowSkillList']/rect[@name='leftPanel']/rect[@name='content']/rect/rect/scrollview/table[@name='skillList']">
						<rect name="attMastery">
							<smx_skills_attribute_entry name="PerkMastery" pos="0,2" size="90,90" rotation="0" />
							<smx_skills_skill_grid pos="130,91" perkCount="6" groupName="Melee Weapon Specialisation" />
							<smx_skills_skill_grid pos="130,-78" perkCount="7" groupName="Ranged Weapon Specialisation" />
							<smx_skills_skill_grid pos="130,-247" perkCount="5" groupName="Unique Specialisation" />
							<smx_skills_skill_grid pos="640,-247" perkCount="3" groupName="Armor Specialisation" />
							<smx_skills_skill_grid pos="130,-416" perkCount="10" groupName="Jack of all Trades" />
							<smx_skills_skill_grid pos="130,-585" perkCount="10" groupName=""/>
							<smx_skills_skill_grid pos="130,-754" perkCount="5" groupName=""/>
							<smx_skills_skill_grid pos="130,-923" perkCount="6" groupName="Vehicles" />	
						</rect>
			</append>
		</if>
	</conditional>	
			
</windows>