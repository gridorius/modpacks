<configs>

<append xpath="/windows">

	<window name="windowToolsForgeT2" width="228" height="121" panel="Right" cursor_area="true" >
		<panel style="header.panel">
			<sprite style="header.icon" sprite="ui_game_symbol_wrench"/>
			<label style="header.name.shrink" text="TOOLS" text_key="xuiTools" />
		</panel>

		<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">

			<grid name="inventory" rows="1" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true"
			required_tools="toolBellowsT2,toolAnvilT2,toolForgeCrucible" required_tools_only="true">
				<item_stack controller="RequiredItemStack" name="0"/>
			</grid>
		</rect>

	</window>

	<window name="windowToolsForgeT3" width="228" height="121" panel="Right" cursor_area="true" >
		<panel style="header.panel">
			<sprite style="header.icon" sprite="ui_game_symbol_wrench"/>
			<label style="header.name.shrink" text="TOOLS" text_key="xuiTools" />
		</panel>

		<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">

			<grid name="inventory" rows="1" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true"
			required_tools="toolBellowsT3,toolAnvilT3,toolForgeCrucible" required_tools_only="true">
				<item_stack controller="RequiredItemStack" name="0"/>
			</grid>
		</rect>

	</window>

	<window name="windowForgeInputT2" width="228" height="204" panel="Right"
		controller="WorkstationMaterialInputWindow" materials_accepted="iron,brass,lead,glass,stone,clay" valid_materials_color="[green]" invalid_materials_color="[red]" cursor_area="true" >
		<panel style="header.panel">
			<sprite style="header.icon" sprite="ui_game_symbol_forge"/>
			<label style="header.name.shrink" text="INPUT" text_key="xuiSmelting" />
		</panel>

		<sprite depth="3" name="backgroundMain" sprite="menu_empty3px" pos="0,-46" height="228" color="[black]" type="sliced" fillcenter="false" />
		<rect name="content" depth="1" pos="0,-46" height="153">

			<grid depth="7" rows="3" cols="1" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationMaterialInputGrid" repeat_content="true">
				<item_stack name="0"/>
			</grid>

		</rect>

		<rect name="content2" depth="0" pos="78, -49" width="147" height="223">
			<sprite depth="2" color="[mediumGrey]" type="sliced"/>
			<grid rows="6" cols="1" pos="3,-3" cell_width="147" cell_height="38"  repeat_content="true">
				<forge_material name="0"/>
			</grid>
		</rect>
	</window>

	<window name="windowOutputT2" width="228" height="198" anchor="CenterTop" panel="Right" cursor_area="true" controller="WorkstationOutputWindow" >
		<panel style="header.panel" pos="0,-75">
			<sprite style="header.icon" sprite="ui_game_symbol_loot_sack"/>
			<label style="header.name.iconright" text="OUTPUT" text_key="xuiOutput" />
			
			<rect pivot="topleft" pos="0,0" controller="ContainerStandardControls" createuiwidget="true" visible="{buttons_visible}">
				<button   depth="3" name="btnMoveAll"          sprite="ui_game_symbol_store_all_up"     tooltip="{take_all_tooltip}"          pos="203, -20" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
			</rect>
		</panel>


		<rect name="content" depth="0" pos="0,-120" height="150" disablefallthrough="true">
			<sprite depth="2" name="backgroundMain" sprite="menu_empty3px" height="225" color="[black]" type="sliced" fillcenter="false" />
				<grid depth="10" name="inventory" rows="3" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationOutputGrid" repeat_content="true">
					<item_stack name="0"/>
				</grid>
		</rect>
	</window>

	<window name="windowForgeInputT3" width="228" height="204" panel="Right"
		controller="WorkstationMaterialInputWindow" materials_accepted="iron,brass,lead,glass,stone,clay" valid_materials_color="[green]" invalid_materials_color="[red]" cursor_area="true" >
		<panel style="header.panel">
			<sprite style="header.icon" sprite="ui_game_symbol_forge"/>
			<label style="header.name.shrink" text="INPUT" text_key="xuiSmelting" />
		</panel>

		<sprite depth="3" name="backgroundMain" sprite="menu_empty3px" pos="0,-46" height="228" color="[black]" type="sliced" fillcenter="false" />
		<rect name="content" depth="1" pos="0,-46" height="153">

			<grid depth="7" rows="3" cols="1" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationMaterialInputGrid" repeat_content="true">
				<item_stack name="0"/>
			</grid>

		</rect>

		<rect name="content2" depth="0" pos="78, -49" width="147" height="223">
			<sprite depth="2" color="[mediumGrey]" type="sliced"/>
			<grid rows="6" cols="1" pos="3,-3" cell_width="147" cell_height="38"  repeat_content="true">
				<forge_material name="0"/>
			</grid>
		</rect>
	</window>

	<window name="windowOutputT3" width="228" height="198" anchor="CenterTop" panel="Right" cursor_area="true" controller="WorkstationOutputWindow" >
		<panel style="header.panel" pos="0,-75">
			<sprite style="header.icon" sprite="ui_game_symbol_loot_sack"/>
			<label style="header.name.iconright" text="OUTPUT" text_key="xuiOutput" />
			
			<rect pivot="topleft" pos="0,0" controller="ContainerStandardControls" createuiwidget="true" visible="{buttons_visible}">
				<button   depth="3" name="btnMoveAll"          sprite="ui_game_symbol_store_all_up"     tooltip="{take_all_tooltip}"          pos="203, -20" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
			</rect>
		</panel>


		<rect name="content" depth="0" pos="0,-120" height="150" disablefallthrough="true">
			<sprite depth="2" name="backgroundMain" sprite="menu_empty3px" height="225" color="[black]" type="sliced" fillcenter="false" />
				<grid depth="10" name="inventory" rows="3" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationOutputGrid" repeat_content="true">
					<item_stack name="0"/>
				</grid>
		</rect>
	</window>

	</append>
</configs>