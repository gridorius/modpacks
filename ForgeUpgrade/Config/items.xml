<config>

<append xpath="/items">

        <item name="ForgeT2Schematic">
	<property name="Extends" value="schematicMaster"/>
	<property name="CreativeMode" value="Player"/>
	<property name="CustomIcon" value="ForgeT2"/>	
	<property name="Unlocks" value="ForgeT2"/>
	<effect_group tiered="false">
		<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="ForgeT2" operation="set" value="1"/>
		<triggered_effect trigger="onSelfPrimaryActionEnd" action="GiveExp" exp="450"/>
	</effect_group>
</item>

