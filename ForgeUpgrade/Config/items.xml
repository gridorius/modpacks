<item name="toolBellowsT2">
	<property name="UnlockedBy" value="craftingWorkstations,toolBellowsT2Schematic"/>
	<property name="Tags" value="workstationSkill"/>
	<property name="HoldType" value="45"/>
	<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
	<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
	<property name="Material" value="MtoolBellows"/>
	<property name="Stacknumber" value="1"/> <!-- STK resource -->
	<property name="Weight" value="0"/>
	<property name="EconomicValue" value="500"/>
	<property name="Group" value="Tools/Traps"/>
	<property name="DisplayType" value="toolBellows"/>
	<property name="ItemTypeIcon" value="forge"/>
	<property name="SoundPickup" value="bellows_grab"/>
	<property name="SoundPlace" value="bellows_place"/>
	<effect_group tiered="false">
		<passive_effect name="CraftingSmeltTime" operation="perc_add" value="-.489"/> <!-- this is essentially a multiplier -->
		<display_value name="dCraftingSmeltTime" value=".75"/>
	</effect_group>
</item>

