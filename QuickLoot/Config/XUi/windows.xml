<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <append xpath="/windows">
        <window name="quickLootPanel" width="536" height="357" anchor="CenterCenter" pos="300,70" depth="210"
                controller="QuickLoot.XUiC_QuickLootPanel, QuickLoot"
                isvisible="false" cursor_area="false">
            <panel name="header" pos="0,0" width="536" height="43" depth="1" backgroundspritename="ui_game_panel_header" bordercolor="[black]" borderthickness="3">
                <sprite name="headerTopStroke" pos="0,0" width="536" height="2" depth="4" sprite="menu_empty3px" color="[black]" type="sliced" />
                <sprite name="headerBottomStroke" pos="0,-41" width="536" height="2" depth="4" sprite="menu_empty3px" color="[black]" type="sliced" />
                <sprite name="headerLeftStroke" pos="0,0" width="2" height="43" depth="4" sprite="menu_empty3px" color="[black]" type="sliced" />
                <sprite name="headerRightStroke" pos="534,0" width="2" height="43" depth="4" sprite="menu_empty3px" color="[black]" type="sliced" />
                <sprite name="windowIcon" pos="6,-5" width="32" height="32" style="icon32px" sprite="ui_game_symbol_loot_sack" color="[iconColor]" />
                <label name="lblQuickLootTitle" pos="45,-6" width="418" height="32" text="Quick Loot" font_size="28" justify="left" overflow="shrinkContent" color="[labelColor]" />
                <label name="lblTargetMeta" pos="474,-8" width="50" height="24" text="" font_size="16" justify="right" color="[disabledLabelColor]" />
            </panel>

            <rect name="body" pos="0,-43" width="536" height="314">
                <sprite name="bg" pos="0,0" width="536" height="314" sprite="menu_empty3px" color="0,0,0,230" type="sliced" />
                <sprite name="outerStroke" pos="0,0" width="536" height="314" sprite="menu_empty3px" color="[black]" type="sliced" />
                <sprite name="innerStroke" pos="6,-6" width="524" height="302" sprite="menu_empty3px" color="[darkGrey]" type="sliced" />
                <label name="lblQuickLootHint" pos="12,-10" width="512" height="22" text="" font_size="14" justify="left" overflow="shrinkContent" color="[disabledLabelColor]" />

                <scrollbar name="quickLootScrollbar" depth="7" pos="518,-166" width="12" height="240" padding="3" foregroundname="handler" backgroundname="background" pivot="center" globalopacitymod="1.15" visible="false">
                    <button name="handler" sprite="quartz_scrollbar_handler" pivot="center" hovercolor="[quartz_scrollbar_handler_hover]" color="[quartz_scrollbar_handler]" defaultcolor="[quartz_scrollbar_handler]" hoverscale="1" />
                    <button name="background" sprite="quartz_scrollbar_background" pivot="center" hovercolor="[quartz_scrollbar_background_hover]" color="[quartz_scrollbar_background]" defaultcolor="[quartz_scrollbar_background]" hoverscale="1" sound_play_on_press_down="[paging_click]" />
                </scrollbar>
                <sprite name="quickLootScrollbarTrack" depth="8" pos="512,-46" width="12" height="240" sprite="quartz_scrollbar_background" color="[quartz_scrollbar_background]" type="sliced" visible="false" />
                <sprite name="quickLootScrollbarThumb" depth="9" pos="512,-46" width="12" height="38" sprite="quartz_scrollbar_handler" color="[quartz_scrollbar_handler]" type="sliced" visible="false" />

                <scrollview name="quickLootScrollview" depth="5" pos="12,-46" width="492" height="240" scrollbar="quickLootScrollbar" reset_position="true" over_scroll="false" scroll_speed="0">
                    <grid name="quickLootRows" rows="12" cols="1" pos="0,0" width="492" height="480" cell_width="492" cell_height="40" repeat_content="true" arrangement="vertical">
                        <rect name="qlRow" width="492" height="38" depth="2">
                            <sprite name="slotBackground" pos="0,0" width="492" height="38" depth="0" sprite="menu_empty3px" color="[darkGrey]" type="sliced" />
                            <sprite name="rowOutline" pos="0,0" width="492" height="38" depth="1" sprite="menu_empty3px" color="[black]" type="sliced" />
                            <sprite name="rowSelectBar" pos="0,0" width="4" height="38" depth="3" sprite="menu_empty3px" color="[selectedColor]" type="sliced" isvisible="false" />
                            <label name="lblRowIndex" pos="7,-7" width="18" height="30" text="" font_size="20" justify="center" color="[selectedColor]" />
                            <sprite name="itemIcon" pos="34,-3" width="32" height="32" depth="2" atlas="ItemIconAtlas" color="[white]" isvisible="false" />
                            <label name="lblItemName" pos="74,-7" width="346" height="30" text="" font_size="20" justify="left" overflow="shrinkContent" color="[labelColor]" />
                            <label name="lblItemCount" pos="430,-7" width="48" height="30" text="" font_size="20" justify="right" color="[labelColor]" />
                        </rect>
                    </grid>
                </scrollview>

                <label name="lblScrollIndicator" pos="406,-288" width="118" height="18" text="" font_size="13" justify="right" color="[disabledLabelColor]" visible="false" />
                <label name="lblFooter" pos="12,-288" width="512" height="18" text="" font_size="13" justify="left" overflow="shrinkContent" color="[disabledLabelColor]" />
            </rect>

            <sprite name="frameTopStroke" pos="0,0" width="536" height="3" depth="20" sprite="menu_empty3px" color="[black]" type="sliced" />
            <sprite name="frameBottomStroke" pos="0,-354" width="536" height="3" depth="20" sprite="menu_empty3px" color="[black]" type="sliced" />
            <sprite name="frameLeftStroke" pos="0,0" width="3" height="357" depth="20" sprite="menu_empty3px" color="[black]" type="sliced" />
            <sprite name="frameRightStroke" pos="533,0" width="3" height="357" depth="20" sprite="menu_empty3px" color="[black]" type="sliced" />
        </window>
    </append>
</configs>
