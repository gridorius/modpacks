<append xpath="//attIntellect">
<append xpath="//perks">
  <perk name="QuickerCrafting" parent="attIntellect" name_key="Quicker Crafting" desc_key="Decreases crafting times (85% is 15% faster, 70% is 30% faster etc.)" icon="ui_game_symbol_craft" min_level="0" max_level="5">
    <level_requirements level="1">
      <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="1" desc_key="reqIntellectLevel02"/>
    </level_requirements>
    <level_requirements level="2">
      <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="2" desc_key="reqIntellectLevel04"/>
    </level_requirements>
    <level_requirements level="3">
      <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="3" desc_key="reqIntellectLevel06"/>
    </level_requirements>
    <level_requirements level="4">
      <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="4" desc_key="reqIntellectLevel08"/>
    </level_requirements>
    <level_requirements level="5">
      <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="5" desc_key="reqIntellectLevel10"/>
    </level_requirements>

    <effect_group>
      <passive_effect name="CraftingTime" operation="perc_add" level="1,2,3,4,5" value="-.15,-.30,-.45,-.60,-.75"/>
    </effect_group>

    <effect_description level="1" desc_key="Quicker Crafting 1" long_desc_key="Increases crafting speed by 15%"/>
    <effect_description level="2" desc_key="Quicker Crafting 2" long_desc_key="Increases crafting speed by 30%"/>
    <effect_description level="3" desc_key="Quicker Crafting 3" long_desc_key="Increases crafting speed by 45%"/>
    <effect_description level="4" desc_key="Quicker Crafting 4" long_desc_key="Increases crafting speed by 60%"/>
    <effect_description level="5" desc_key="Quicker Crafting 5" long_desc_key="Increases crafting speed by 75%"/>
  </perk>
</append>
</append>