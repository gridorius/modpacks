<configs>

    <!-- ========================================================================== -->
    <!-- Challenger 货币 — 残蚀碎片                                                 -->
    <!-- 10残蚀碎片 = 3000 金币                                                     -->
    <!-- ========================================================================== -->
    <append xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']">
        <item name="resourceChallengerShard" count="10,50" value="300,1500"/>
    </append>

    <!-- ========================================================================== -->
    <!-- Challenger 挑战书 — T1-T6 可在商店购买                                      -->
    <!-- ========================================================================== -->
    <append xpath="/traders/trader_item_groups/trader_item_group[@name='traderGeneral']">
        <item name="itemChallengerChallengeScrollT1" count="1,3" prob="0.3"/>
        <item name="itemChallengerChallengeScrollT2" count="1,3" prob="0.25"/>
        <item name="itemChallengerChallengeScrollT3" count="1,2" prob="0.2"/>
        <item name="itemChallengerChallengeScrollT4" count="1,2" prob="0.15"/>
        <item name="itemChallengerChallengeScrollT5" count="1,2" prob="0.1"/>
        <item name="itemChallengerChallengeScrollT6" count="1,1" prob="0.05"/>
    </append>

</configs>
