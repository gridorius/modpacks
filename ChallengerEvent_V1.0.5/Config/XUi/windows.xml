                        pos="105,-6"
                        width="110"
                        height="24"
                        font="ReferenceFont"
                        font_size="20"
                        justify="right"
                        color="255,255,255,230"
                        text="0/0"/>

                    <sprite name="challengeProgressBack1"
                            depth="2"
