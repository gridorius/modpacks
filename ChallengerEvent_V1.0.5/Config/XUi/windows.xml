            </rect>
        </window>

    </append>

    <!-- ===================================================== -->
    <!-- 挑战者指南专用大窗口（1280×780，约 2/3 屏幕）              -->
    <!-- ===================================================== -->
    <append xpath="/windows">
        <window name="windowChallengerGuide" anchor="CenterCenter" pos="-640,390" width="1280" height="780" cursor_area="true" depth="1000">
            <panel name="noclick" depth="0" createuipanel="true" on_press="true" pos="-4000,4000" width="8000" height="8000" disableautobackground="true" gamepad_selectable="false">
                <sprite depth="0" name="backgroundMain" sprite="menu_empty" color="0,0,0,200" type="sliced" fillcenter="true" />
            </panel>

            <panel name="header" pos="0,0" height="48" depth="1" backgroundspritename="ui_game_panel_header" bordercolor="[black]" borderthickness="3">
                <label style="header.name" pos="8,-6" width="1264" font_size="34" text="Survivor Pre-Deployment Briefing" text_key="challengerGuideTitle" />
            </panel>

            <panel name="content" pos="0,-52" height="676" depth="1" backgroundcolor="[darkGrey]" bordercolor="[black]" borderthickness="3" pivot="center">
                <sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" height="676" width="1280" color="[black]" type="sliced" fillcenter="false" />
                <label depth="3" name="descriptionText" pos="12,-8" width="1256" height="620" text="" text_key="challengerGuideMessage" font_size="26" overflow="resizeheight" upper_case="false" />

                <label depth="3" pos="0,-696" width="1280" height="28" justify="center" text_key="challengerGuideCloseHint" font_size="24" color="200,200,200,255" />
            </panel>
        </window>
    </append>

</Nanami_cyber>