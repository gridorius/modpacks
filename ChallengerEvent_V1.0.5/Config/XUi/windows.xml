<Nanami_cyber> 
    <append xpath="/windows">
   
        <window name="windowChallengerHud"
                anchor="CenterTop"
                controller="GameEvent.SequenceActions.XUiC_ChallengerHud, ChallengerEvent"
                width="1920"
                height="1080">

            <rect name="challengerHudRoot"
                pivot="center"
                pos="0,-200"
                width="1920"
                height="1080"
                depth="30">

                <!-- Slot 0 -->
                <rect name="challengeSlot0"
                    pivot="center"
                    pos="0,455"
                    width="340"
                    height="86"
                    depth="1"
                    visible="false">

                    <sprite name="challengeBack0"
                            depth="1"
                            pivot="center"
                            pos="0,0"
                            width="340"
                            height="86"
                            sprite="menu_empty"
                            color="0,0,0,145"
                            type="sliced"
                            fillcenter="true"/>

                    <label name="challengeTitle0"
                        depth="2"
                        pivot="center"
                        pos="0,24"
                        width="320"
                        height="26"
                        font="ReferenceFont"
                        font_size="20"
                        font_style="Bold"
                        justify="center"
                        color="255,220,160,255"
                        text="挑战任务"/>

                    <label name="challengeTime0"
                        depth="2"
                        pivot="center"
                        pos="-105,-6"
                        width="110"
                        height="24"
                        font="ReferenceFont"
                        font_size="20"
                        justify="left"
                        color="255,255,255,230"
                        text="--:--"/>

                    <label name="challengeKill0"
                        depth="2"
                        pivot="center"
                        pos="105,-6"
                        width="110"
                        height="24"
                        font="ReferenceFont"
                        font_size="20"
                        justify="right"
                        color="255,255,255,230"
                        text="0/0"/>

                    <sprite name="challengeProgressBack0"
                            depth="2"
                            pivot="center"
                            pos="0,-32"
                            width="300"
                            height="10"
                            sprite="menu_empty"
                            color="45,45,45,190"
                            type="sliced"
                            fillcenter="true"/>

                    <sprite name="challengeProgressFill0"
                            depth="3"
                            pivot="center"
                            pos="0,-32"
                            width="300"
                            height="10"
                            sprite="menu_empty"
                            color="255,110,30,230"
                            type="filled"
                            filldirection="horizontal"/>
                </rect>

                <!-- Slot 1 -->
                <rect name="challengeSlot1"
                    pivot="center"
                    pos="0,455"
                    width="340"
                    height="86"
                    depth="1"
                    visible="false">

                    <sprite name="challengeBack1"
