                            pos="0,-32"
                            width="300"
                            height="10"
                            sprite="menu_empty"
                            color="255,110,30,230"
                            type="filled"
                            filldirection="horizontal"/>
                </rect>

                <!-- Slot 2 -->
                <rect name="challengeSlot2"
                    pivot="center"
                    pos="0,455"
                    width="340"
                    height="86"
                    depth="1"
                    visible="false">

                    <sprite name="challengeBack2"
                            depth="1"
