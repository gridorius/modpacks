<configs>

<!-- quest tracker window improvement -->
<set xpath="/windows/window[@name='windowQuestTracker']/grid[@name='objectiveList']/@incomplete_icon">ui_game_symbol_minus1</set>
<setattribute xpath="/windows/window[@name='windowQuestTracker']/grid[@name='objectiveList']" name="incomplete_color">[red]</setattribute>

<!-- quest offer window improvements -->
<setattribute xpath="/windows/window[@name='windowQuestOffer']/panel[@name='header']" name="color">0,0,0</setattribute>
<setattribute xpath="/windows/window[@name='windowQuestOffer']/panel[@name='header']" name="bordercolor">255,255,255</setattribute>
<setattribute xpath="/windows/window[@name='windowQuestOffer']/panel[@name='header']" name="borderthickness">3</setattribute>
<set xpath="/windows/window[@name='windowQuestOffer']/panel[@name='header']/label[@pos='395,-10']">495,-10</set>

<!-- Resize the quest selection window with a wider and more solid background; also allow for MoreQuests and SMX mods if installed -->
<conditional>
	<if cond="mod_loaded('SMXcore') == 'true' and mod_loaded('Quartz') =='true'">
		<remove xpath="//window[@name='windowResponses']/grid"/>
			<append xpath="//window[@name='windowResponses']" >
				<rect name="rectOptions" pos="0,-25" height="190" width="580" depth="1">
					<scrollbar name="scrollbar" depth="75" pos="697,-170" width="25" height="295" padding="4" foregroundcolor="[darkGrey]" foregroundsprite="menu_empty3px" pivot="center" />
					<scrollview name="scrollable_response" depth="50" scrollbar="scrollbar" reset_position="true" over_scroll="false" scroll_speed=".55">
						<grid name="items" pos="3,-18" rows="60" cols="1" width="590" height="200" cell_width="590" cell_height="40" repeat_content="true" arrangement="vertical" >
							<smx_response_entry id="0" /> <!-- SMX specific -->
						</grid>
				</scrollview>
			</rect>
		</append>
	</if>
</conditional>
<!-- fixes compatability for WMMTraderMap (or my own personal horizontal version) which MoreQuests breaks -->
<conditional>
	<if cond="mod_loaded('Quartz') =='true' and mod_loaded('MoreQuestsNoScrollbar') =='true' and mod_loaded('MoreQuestOptions') =='false'">
		<remove xpath="//window[@name='windowResponses']"/>
		<insertBefore xpath="//window[@name='windowStatement']">
			<window name="windowResponses" pos="-740,120" width="700" height="320" anchor="RightCenter" cursor_area="true" controller="DialogResponseList">
				<label name="lblName" style="subtitle" text="{respondentname}" color="[selectedColor]" justify="left" depth="5" pos="11,16" />
				<sprite depth="0" name="background" pos="-25,35" width="760" height="382" type="sliced" color="96,96,96,255" globalopacity="false"/>
				<sprite depth="1" name="foreground" pos="-20,30" width="750" height="372" type="sliced" color="0,0,0,255" globalopacity="false"/>
				<rect name="showtime" pos="555,30"> 
					<sprite depth="2" name="dayTimeIcon" width="24" height="24" pos="-10,-8" sprite="ui_game_symbol_clock" color="[iconColor]" foregroundlayer="true" visible="{showtime}"/>
					<label depth="2" name="dayTimeLabel" width="230" height="28" pos="21,-9" text="{mapdaytimetitle}: [DECEA3]{mapdaytime}[-]" font_size="22" controller="MapStats" visible="{showtime}"/>
				</rect>
				<rect name="rectOptions" pos="0,-25" height="290" width="640" depth="1">
					<scrollview name="scrollable_response" depth="5" scrollbar="scrollbar" reset_position="true" over_scroll="false" scroll_speed=".55">
						<grid name="items" pos="3,-15" rows="50" cols="1" width="640" height="300" cell_width="640" cell_height="40" repeat_content="true" arrangement="vertical" >
							<response_entry id="0" />
						</grid>
					</scrollview>
					<scrollbar name="scrollbar" depth="10" pos="697,-143" width="15" height="290" padding="4" foregroundcolor="[darkGrey]" foregroundsprite="menu_empty3px" pivot="topLeft" />
				</rect>
			</window>
		</insertBefore>
	</if>
	<!--
	<else>
		<set xpath="/windows/window[@name='windowResponses']/@pos">-740,135</set>
		<remove xpath="/windows/window[@name='windowResponses']/sprite"/>
		<append xpath="/windows/window[@name='windowResponses']">
			<sprite depth="0" name="background" pos="-25,35" width="760" height="382" type="sliced" color="96,96,96,255" globalopacity="false"/>
			<sprite depth="1" name="foreground" pos="-20,30" width="750" height="372" type="sliced" color="0,0,0,255" globalopacity="false"/>
			<rect name="showtime" pos="555,30"> 
				<sprite depth="2" name="dayTimeIcon" width="24" height="24" pos="-10,-8" sprite="ui_game_symbol_clock" color="[iconColor]" foregroundlayer="true" visible="{showtime}"/>
				<label depth="2" name="dayTimeLabel" width="230" height="28" pos="21,-9" text="{mapdaytimetitle}: [DECEA3]{mapdaytime}[-]" font_size="22" controller="MapStats" visible="{showtime}"/>
			</rect>
		</append>
	</else>
	-->
</conditional>

