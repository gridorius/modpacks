<!-- COMMENT OUT THIS CONDITIONAL SECTION BELOW IF YOU DO NOT WANT THE EXTRA TIERS -->	
<!-- Reserve these quest entries on the dialog UI for the expanded quest index -->
	<conditional>
		<if cond="mod_loaded('MoreQuestOptions') or mod_loaded('MoreQuestsNoScrollbar')">
			<insertAfter xpath="//dialog[@id='trader']/statement[@id='currentjobs7' or @id='currentjobs8' or @id='currentjobs9' or @id='currentjobs10']/quest_entry[@listindex='6']">
				<quest_entry listindex="7" tier="1" />
				<quest_entry listindex="8" tier="1" />
				<quest_entry listindex="9" tier="1" />
				<quest_entry listindex="10" tier="1" />
			</insertAfter>

			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs7']/quest_entry/@tier">7</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs8']/quest_entry/@tier">8</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs9']/quest_entry/@tier">9</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs10']/quest_entry/@tier">10</set>
		</if>
		<else>
			<insertAfter xpath="//dialog[@id='trader']/statement[starts-with(@id,'currentjobs')]/quest_entry[@listindex='6']">
				<quest_entry listindex="7" tier="8" />
				<quest_entry listindex="8" tier="9" />
				<quest_entry listindex="9" tier="10" />
			</insertAfter>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs1']/quest_entry/@tier">1</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs2']/quest_entry/@tier">2</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs3']/quest_entry/@tier">3</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs4']/quest_entry/@tier">4</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs5']/quest_entry/@tier">5</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs6']/quest_entry/@tier">6</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs7']/quest_entry/@tier">7</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs8']/quest_entry/@tier">8</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs9']/quest_entry/@tier">9</set>
			<set xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs10']/quest_entry/@tier">10</set>
		</else>
	</conditional>

