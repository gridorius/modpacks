<?xml version="1.0" encoding="UTF-8"?>
<configs>
  <append xpath="/item_modifiers">
    <!--
      Packwisely pouches are chest-armor attachment mods. The C# side detects
      them by their modifier_tags, then stores the virtual pouch contents on the
      equipped chest armor ItemValue.Metadata. Do not add active item effects here;
      the storage, capacity and filters are owned by Source/Pouches/*.cs.

      These modifiers extend vanilla modGeneralMaster so the recipe/unlock/loot
      systems see them like normal armor mods. T3/T4 also expose UnlockedBy to
      match their schematics and learnable recipes.
    -->

    <!-- Ammo pouches: ammo-only virtual storage. T1 fits chest/lower-body armor; higher tiers are chest-only. -->
    <item_modifier name="modArmorPackwiselyAmmoPouchT1" installable_tags="armorChest,armorFeet" modifier_tags="packwiselyAmmoPouch,packwiselyAmmoPouchT1" blocked_tags="noMods,packwiselyAmmoPouch" type="attachment">
      <property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
      <property name="CreativeMode" value="Player" />
      <property name="CustomIcon" value="packwiselySmallAmmoPouch" />
      <property name="Stacknumber" value="1" />
      <property name="HoldType" value="45" />
      <property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab" />
      <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
      <property name="Material" value="Mleather" />
      <property name="Weight" value="1" />
      <property name="EconomicValue" value="350" />
      <property name="Group" value="Mods,Armor Mods" />
      <property name="SoundPickup" value="mod_grab" />
      <property name="SoundPlace" value="mod_place" />
    </item_modifier>

