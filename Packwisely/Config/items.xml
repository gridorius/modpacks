<?xml version="1.0" encoding="UTF-8"?>
<configs>
  <append xpath="/items">
    <!--
      T3/T4 pouch schematics. Reading one sets the recipe CVar used by vanilla
      learnable recipes. T1 remains a starter craft and T2 remains a normal
      workbench upgrade; only the late-game pouches require these plans.
    -->

    <!-- Ammo pouch schematics. -->
    <item name="modArmorPackwiselyAmmoPouchT3Schematic">
      <property name="Extends" value="schematicNoQualityMaster" />
      <property name="CreativeMode" value="Player" />
      <property name="CustomIcon" value="packwiselyTacticalBandolier" />
      <property name="Unlocks" value="modArmorPackwiselyAmmoPouchT3" />
      <effect_group tiered="false">
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="modArmorPackwiselyAmmoPouchT3" operation="set" value="1" />
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="GiveExp" exp="100" />
      </effect_group>
    </item>

    <item name="modArmorPackwiselyAmmoPouchT4Schematic">
      <property name="Extends" value="schematicNoQualityMaster" />
