<configs>
    <!-- UI Visual Entry -->
    <append xpath="//crafting_skill[@name='craftingRobotics']">
        <display_entry item="9mmJunkTurret" unlock_level="50,52,54,56,58,60"/>
    </append>

    <!-- Logic: Unlock and Tiering -->
    <append xpath="//crafting_skill[@name='craftingRobotics']/effect_group">
        <passive_effect name="RecipeTagUnlocked" operation="base_set" level="50,60" value="1" tags="9mmJunkTurret"/>
        <passive_effect name="CraftingTier" operation="base_add" level="50,52,54,56,58,60" value="1,2,3,4,5,5" tags="9mmJunkTurret"/>
    </append>
	
	<append xpath="//crafting_skill[@name='craftingRobotics']">
        <display_entry item="762JunkTurret" unlock_level="80,82,84,86,88,90"/>
    </append>

    <!-- Logic: Unlock and Tiering -->
    <append xpath="//crafting_skill[@name='craftingRobotics']/effect_group">
        <passive_effect name="RecipeTagUnlocked" operation="base_set" level="80,90" value="1" tags="762JunkTurret"/>
        <passive_effect name="CraftingTier" operation="base_add" level="80,82,84,86,88,90" value="1,2,3,4,5,5" tags="762JunkTurret"/>
    </append>
	
	<append xpath="//crafting_skill[@name='craftingRobotics']">
        <display_entry item="ShotgunJunkTurret" unlock_level="90,92,94,96,98,100"/>
    </append>

    <!-- Logic: Unlock and Tiering -->
    <append xpath="//crafting_skill[@name='craftingRobotics']/effect_group">
        <passive_effect name="RecipeTagUnlocked" operation="base_set" level="90,100" value="1" tags="ShotgunJunkTurret"/>
        <passive_effect name="CraftingTier" operation="base_add" level="90,92,94,96,98,100" value="1,2,3,4,5,5" tags="ShotgunJunkTurret"/>
    </append>
	
	<append xpath="//crafting_skill[@name='craftingRobotics']">
        <display_entry item="44magnumJunkTurret" unlock_level="60,62,64,66,68,70"/>
    </append>

    <!-- Logic: Unlock and Tiering -->
    <append xpath="//crafting_skill[@name='craftingRobotics']/effect_group">
        <passive_effect name="RecipeTagUnlocked" operation="base_set" level="60,70" value="1" tags="44magnumJunkTurret"/>
        <passive_effect name="CraftingTier" operation="base_add" level="60,62,64,66,68,70" value="1,2,3,4,5,5" tags="44magnumJunkTurret"/>
    </append>
	
<!-- Leave the upper shit alone, this only applies to myself-->

	<append xpath="/progression/perks">
        <perk name="perkRoboticLegion" max_level="3" parent="skillGeneralPerks" name_key="perkRoboticLegionName" desc_key="perkRoboticLegionDesc" icon="ui_game_symbol_electric_turret" override_cost="3,5,5">
            
            <!-- Requirement: Lock it behind Intellect 10 so it feels like an endgame reward -->
            <level_requirements level="1">
                <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="10" desc_key="reqIntellectLevel10"/>
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="GTE" value="5" desc_key="reqRoboticsInventor05"/>
            </level_requirements>
			
            <level_requirements level="2">
                <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="10" desc_key="reqIntellectLevel10"/>
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="5" desc_key="reqRoboticsInventor05"/>
            </level_requirements> 
			
			<level_requirements level="3">
                <requirement name="ProgressionLevel" progression_name="attIntellect" operation="GTE" value="10" desc_key="reqIntellectLevel10"/>
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="5" desc_key="reqRoboticsInventor05"/>
            </level_requirements> 

            <effect_group>
                <!-- Level 1 adds +1 turret (Total 3), Level 2 adds +2 turrets (Total 4) -->
                <passive_effect name="JunkTurretActiveCount" operation="base_add" level="1,2,3" value="1,2,3" />
                
                <!-- Descriptions for the UI -->
                <effect_description level="1" desc_key="perkRoboticLegionRank1Desc" long_desc_key="perkRoboticLegionRank1LongDesc" />
                <effect_description level="2" desc_key="perkRoboticLegionRank2Desc" long_desc_key="perkRoboticLegionRank2LongDesc" />
		<effect_description level="3" desc_key="perkRoboticLegionRank3Desc" long_desc_key="perkRoboticLegionRank3LongDesc" />
            </effect_group>
        </perk>
    </append>
	

	
</configs>
	
